rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isUser() {
      return request.auth != null;
    }

    function isMerchant() {
      return isUser() && exists(/databases/$(database)/documents/merchants/$(request.auth.uid));
    }

    function isAdmin() {
      return isUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function ownsTag(tagId) {
      return isUser()
        && exists(/databases/$(database)/documents/tags/$(tagId))
        && get(/databases/$(database)/documents/tags/$(tagId)).data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isUser() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isUser() && request.auth.uid == uid;
    }

    match /merchants/{uid} {
      allow read: if isUser();
      allow create, update: if isUser() && request.auth.uid == uid;
    }

    match /admins/{uid} {
      allow read: if isUser();
      allow create, update: if isUser() && request.auth.uid == uid;
    }

    match /tags/{tagId} {
      allow read: if isUser();
      allow create: if isUser() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin()
        || (isUser() && resource.data.userId == request.auth.uid);
    }

    match /wallets/{tagId} {
      allow read: if isUser();
      allow create: if isUser();
      allow update: if isMerchant() || isAdmin()
        || (ownsTag(tagId) && request.resource.data.balancePaise >= resource.data.balancePaise);
    }

    match /txns/{id} {
      allow read: if isUser();
      allow create: if isUser();
      allow update, delete: if isAdmin();
    }
  }
}
