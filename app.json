{
  "expo": {
    "name": "TapPay",
    "slug": "tappay",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tappay",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tappay.hackathon",
      "infoPlist": {
        "NFCReaderUsageDescription": "TapPay uses NFC to bind and read wristband tags."
      }
    },
    "android": {
      "package": "com.tappay.hackathon",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.NFC"],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F3D2E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "TapPay uses NFC to bind and read wristband tags."
        }
      ],
      "./plugins/withNfcFeature"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
