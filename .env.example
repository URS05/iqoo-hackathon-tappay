# Copy to .env.local. App still runs without these (local ledger + mock NFC).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Shared secret for NDEF HMAC (demo only, not bank-grade)
EXPO_PUBLIC_TAG_HMAC_SECRET=tappay-demo-hmac

# Set to 1 to force mock NFC even on Android
EXPO_PUBLIC_FORCE_MOCK_NFC=0
